{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": false, // true
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "paths": {
      "@helpers/*": [
        "./src/helpers/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@middleware/*": [
        "./src/middleware/*"
      ],
      "@models": [
        "./src/models",
        "./src/models/index"
      ],
      "@models/*": [
        "./src/models/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts"
  ]
}